# =======================================================
# SATUZIKIR ENVIRONMENT VARIABLES (.env.local)
# =======================================================

# 1. Supabase Production Live Credentials
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. PIN Akses Cepat Admin Hub (Default: 123456)
NEXT_PUBLIC_ADMIN_PIN=123456

# 3. Google Gemini API Key (Untuk AI Campaign Generator di /admin)
# Dapatkan gratis dari: https://aistudio.google.com/
GEMINI_API_KEY=
