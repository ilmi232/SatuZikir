# =======================================================
# SATUZIKIR ENVIRONMENT VARIABLES (.env.local)
# Jangan pernah commit .env.local atau menulis API key langsung di kode.
# =======================================================

# 1. Supabase (Dashboard Supabase -> Project Settings -> API)
# Kosongkan keduanya untuk mode demo lokal (data hanya di browser).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. URL publik aplikasi (untuk gambar preview link WhatsApp/sosmed)
NEXT_PUBLIC_SITE_URL=https://satuzikir.example.com

# 3. Admin (hanya dibaca server — JANGAN diberi prefix NEXT_PUBLIC_, set tipe Secret di Vercel)
# PIN login admin, 6 digit angka
ADMIN_PIN=
# Kunci tanda tangan cookie sesi admin, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Supabase -> Project Settings -> API -> service_role (dipakai server untuk operasi admin)
SUPABASE_SERVICE_ROLE_KEY=

# 4. AI Campaign Generator (hanya dibaca di server, JANGAN diberi prefix NEXT_PUBLIC_)
# Google Gemini: https://aistudio.google.com/
GEMINI_API_KEY=
# NVIDIA NIM (cadangan): https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3

